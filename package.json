{
  "name": "labelfit-india",
  "version": "0.1.0",
  "private": true,
  "description": "A prototype for explaining visible label information on packaged complementary foods.",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "baseline:verify": "node scripts/verify_baseline.js",
    "prove:scan": "node scripts/prove_local_workflow_scan.js",
    "benchmark:off": "python scripts/fetch_openfoodfacts_benchmark.py",
    "benchmark:build": "python scripts/build_10sku_benchmark.py",
    "benchmark:build:50": "python scripts/build_50sku_benchmark.py",
    "benchmark:strata": "python scripts/build_50sku_benchmark.py --strata",
    "benchmark:eval": "python scripts/evaluate_benchmark.py --csv docs/benchmark-10sku-results.csv --export-markdown docs/BENCHMARK_EVALUATION_REPORT.md",
    "benchmark:eval:50": "python scripts/evaluate_benchmark.py --csv docs/benchmark-50sku-results.csv --export-markdown docs/BENCHMARK_50_SKU_SCORECARD.md",
    "benchmark:scan": "node scripts/scan_benchmark.js",
    "benchmark:apply": "python scripts/apply_scan_run.py",
    "benchmark:score": "python scripts/score_benchmark.py",
    "transcription:input": "python scripts/transcribe_cli.py",
    "transcription:pending": "python scripts/transcribe_cli.py --list-pending",
    "transcription:adjudicate": "python scripts/adjudicate_transcriptions.py --csv docs/founder-independent-transcriptions.csv",
    "usability:session": "python scripts/record_caregiver_session.py",
    "usability:eval": "python scripts/evaluate_usability.py --csv docs/usability-evaluation-sheet.csv --export-markdown docs/USABILITY_EVALUATION_REPORT.md"
  },
  "engines": { "node": ">=20" }
}
