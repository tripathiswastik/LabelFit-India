{
  "name": "labelfit-india",
  "version": "0.1.0",
  "private": true,
  "description": "A prototype for explaining visible label information on packaged complementary foods.",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "prove:scan": "node scripts/prove_local_workflow_scan.js",
    "benchmark:off": "python scripts/fetch_openfoodfacts_benchmark.py",
    "benchmark:build": "python scripts/build_50sku_benchmark.py",
    "benchmark:eval": "python scripts/evaluate_benchmark.py --csv docs/benchmark-template.csv --export-markdown docs/BENCHMARK_EVALUATION_REPORT.md"
  },
  "engines": { "node": ">=20" }
}
